# 배포 서버(개발·운영 공통) /opt/app/.env 의 규격
# 이 파일을 복사해 값을 채운 뒤 서버에 .env 로 저장한다. 실제 값이 담긴 .env 는 커밋하지 않는다.

# 이 서버가 어느 환경인지. dev 또는 prod 를 적는다.
# 값이 없으면 컨테이너를 만들기 전에 배포가 멈춘다. 스키마 반영 정책과 쿼리 로그가 이 값으로 갈린다.
SPRING_PROFILES_ACTIVE=

MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# 앱과 MySQL 이 같은 값을 쓴다. 한쪽만 바꾸면 없는 DB 에 붙어 기동에 실패한다.
MYSQL_DATABASE=devica

# Grafana Cloud 로 메트릭과 로그를 보낼 때 쓴다. 비어 있으면 수집 에이전트만 실패하고 앱은 뜬다.
# 같은 스택의 metrics:write, logs:write 권한이 있는 기존 토큰을 사용한다.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_TOKEN=

# Loki 로그 전송 주소(/loki/api/v1/push 포함)와 사용자 ID. 메트릭 접속 정보와 별도로 확인한다.
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=

# 제품 이미지 주소(필수). 미설정 시 배포가 중단된다.
# 버킷 또는 CloudFront 도메인 루트만 지정한다. image_key의 devica/dev 경로는 넣지 않는다.
PRODUCT_IMAGE_BASE_URL=

# 배포할 이미지 태그(커밋 SHA). 배포 스크립트가 갱신한다.
IMAGE_TAG=
