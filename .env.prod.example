# 운영 서버 /opt/app/.env 의 규격
# 이 파일을 복사해 값을 채운 뒤 서버에 .env 로 저장한다. 실제 값이 담긴 .env 는 커밋하지 않는다.

MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# 앱과 MySQL 이 같은 값을 쓴다. 한쪽만 바꾸면 없는 DB 에 붙어 기동에 실패한다.
MYSQL_DATABASE=devica

# 운영 스키마는 deploy/sql 아래 SQL을 먼저 적용하고 애플리케이션에서는 검증만 한다.
DDL_AUTO=validate

# 배포할 이미지 태그(커밋 SHA). 배포 스크립트가 갱신한다.
IMAGE_TAG=
