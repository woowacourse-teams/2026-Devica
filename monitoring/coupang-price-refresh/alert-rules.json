{
  "folderUid": "__FOLDER_UID__",
  "title": "coupang-price-refresh-__ENV__",
  "interval": 60,
  "rules": [
    {
      "uid": "devica-coupang-price-changed-__ENV__",
      "orgID": 1,
      "folderUID": "__FOLDER_UID__",
      "ruleGroup": "coupang-price-refresh-__ENV__",
      "title": "쿠팡 가격 변경 (__ENV__)",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "queryType": "instant",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__LOKI_UID__",
          "model": {
            "datasource": {
              "type": "loki",
              "uid": "__LOKI_UID__"
            },
            "expr": "sum by (env, offer_id, product_code, product_url, offer_url, price_refresh_result, price_refresh_action, error_code, price_refresh_previous_price, price_refresh_current_price) (count_over_time({env=\"__ENV__\", app=\"devica-app\"} | json | log_logger=\"com.wrb.devica.product.infra.coupang.CoupangPriceRefreshJob\" | price_refresh_price_changed=\"true\" | __error__=\"\" | keep env, offer_id, product_code, product_url, offer_url, price_refresh_result, price_refresh_action, error_code, price_refresh_previous_price, price_refresh_current_price [15m]))",
            "queryType": "instant",
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "refId": "B",
            "type": "threshold",
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": true,
      "labels": {
        "service": "devica",
        "job": "coupang-price-refresh",
        "env": "__ENV__",
        "severity": "info"
      },
      "annotations": {
        "summary": "{{ $labels.product_code }} 가격 변경",
        "description": "가격: {{ $labels.price_refresh_previous_price }}원 → {{ $labels.price_refresh_current_price }}원\n\nDevica: {{ $labels.product_url }}\n쿠팡: {{ $labels.offer_url }}\n오퍼 ID: {{ $labels.offer_id }}\n숨김 상태에서 Devica 상세는 404를 반환합니다. 쿠팡 링크로 확인하세요."
      }
    },
    {
      "uid": "devica-coupang-visibility-changed-__ENV__",
      "orgID": 1,
      "folderUID": "__FOLDER_UID__",
      "ruleGroup": "coupang-price-refresh-__ENV__",
      "title": "쿠팡 판매상품 숨김·복구 (__ENV__)",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "queryType": "instant",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__LOKI_UID__",
          "model": {
            "datasource": {
              "type": "loki",
              "uid": "__LOKI_UID__"
            },
            "expr": "sum by (env, offer_id, product_code, product_url, offer_url, price_refresh_result, price_refresh_action, error_code) (count_over_time({env=\"__ENV__\", app=\"devica-app\"} | json | log_logger=\"com.wrb.devica.product.infra.coupang.CoupangPriceRefreshJob\" | price_refresh_action=~\"HIDDEN|RESTORED\" | __error__=\"\" | keep env, offer_id, product_code, product_url, offer_url, price_refresh_result, price_refresh_action, error_code [15m]))",
            "queryType": "instant",
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "refId": "B",
            "type": "threshold",
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": true,
      "labels": {
        "service": "devica",
        "job": "coupang-price-refresh",
        "env": "__ENV__",
        "severity": "warning"
      },
      "annotations": {
        "summary": "{{ $labels.product_code }} {{ $labels.price_refresh_action }}",
        "description": "HIDDEN: 검색 후보가 있고 모든 후보의 ID를 읽었지만 기존 ID가 없어 숨겼습니다. RESTORED: 기존 ID와 유효한 가격을 다시 확인해 노출을 복구했습니다. 판매 종료 확정 알림은 아닙니다.\n\nDevica: {{ $labels.product_url }}\n쿠팡: {{ $labels.offer_url }}\n오퍼 ID: {{ $labels.offer_id }}\n숨김 상태에서 Devica 상세는 404를 반환합니다. 쿠팡 링크로 확인하세요."
      }
    },
    {
      "uid": "devica-coupang-review-required-__ENV__",
      "orgID": 1,
      "folderUID": "__FOLDER_UID__",
      "ruleGroup": "coupang-price-refresh-__ENV__",
      "title": "쿠팡 가격 확인 필요 (__ENV__)",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "queryType": "instant",
          "relativeTimeRange": {
            "from": 900,
            "to": 0
          },
          "datasourceUid": "__LOKI_UID__",
          "model": {
            "datasource": {
              "type": "loki",
              "uid": "__LOKI_UID__"
            },
            "expr": "sum by (env, offer_id, product_code, product_url, offer_url, price_refresh_result, price_refresh_action, error_code) (count_over_time({env=\"__ENV__\", app=\"devica-app\"} | json | log_logger=\"com.wrb.devica.product.infra.coupang.CoupangPriceRefreshJob\" | price_refresh_result=~\"NO_SEARCH_RESULTS|IDENTIFIER_UNAVAILABLE|INVALID_PRICE|CONFLICTING_PRICES|API_FAILURE|DB_FAILURE|SKIPPED\" | __error__=\"\" | keep env, offer_id, product_code, product_url, offer_url, price_refresh_result, price_refresh_action, error_code [15m]))",
            "queryType": "instant",
            "refId": "A",
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "A",
            "refId": "B",
            "type": "threshold",
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "B"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ]
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "0s",
      "isPaused": true,
      "labels": {
        "service": "devica",
        "job": "coupang-price-refresh",
        "env": "__ENV__",
        "severity": "warning"
      },
      "annotations": {
        "summary": "{{ $labels.product_code }} 확인 필요: {{ $labels.price_refresh_result }}",
        "description": "NO_SEARCH_RESULTS: 검색 결과 없음. IDENTIFIER_UNAVAILABLE: URL 해석 또는 ID 누락. INVALID_PRICE/CONFLICTING_PRICES: 가격 검증 실패. API_FAILURE: 외부 조회 실패. DB_FAILURE: 저장 실패. SKIPPED: 조회 중 저장 대상 변경. 기존 가격과 노출 상태를 유지했습니다. {{ if $labels.error_code }}오류: {{ $labels.error_code }}{{ end }}\n\nDevica: {{ $labels.product_url }}\n쿠팡: {{ $labels.offer_url }}\n오퍼 ID: {{ $labels.offer_id }}\n숨김 상태에서 Devica 상세는 404를 반환합니다. 쿠팡 링크로 확인하세요."
      }
    }
  ]
}
