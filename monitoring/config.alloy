// 요금이 series 당 분당 1개 데이터 기준이라 수집 간격은 60초로 둔다.

prometheus.scrape "app" {
  targets         = [{"__address__" = "app:8081", "job" = "devica-app"}]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.exporter.unix "host" {
  procfs_path    = "/host/proc"
  sysfs_path     = "/host/sys"
  rootfs_path    = "/host/root"
  set_collectors = ["cpu", "meminfo", "vmstat", "filesystem", "loadavg"]

  // rootfs 에는 루트 디스크의 디렉터리 하나만 마운트하므로 / 외의 마운트 지점은 잴 수 없다.
  filesystem {
    mount_points_exclude = "^/.+"
  }
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.exporter.self "alloy" { }

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.alloy.receiver]
}

prometheus.relabel "alloy" {
  rule {
    source_labels = ["__name__"]
    regex         = "loki_write_dropped_entries_total"
    action        = "keep"
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// RDS 지표는 CloudWatch 에만 있어 여기서 가져온다. 권한은 EC2 인스턴스 역할(IMDS)로 얻는다.
// 인스턴스를 이름으로 지정해 태그 조회 권한 없이 읽는다. 이름 규칙은 db-devica-<env> 다.
// RDS 지표는 1분 단위인데 CloudWatch 반영이 늦어, 최근 5분 중 마지막 값을 쓴다.
prometheus.exporter.cloudwatch "rds" {
  sts_region = "ap-northeast-2"

  static "rds" {
    regions    = ["ap-northeast-2"]
    namespace  = "AWS/RDS"
    dimensions = { "DBInstanceIdentifier" = "db-devica-" + sys.env("DEVICA_ENV") }

    metric {
      name       = "FreeStorageSpace"
      statistics = ["Minimum"]
      period     = "1m"
      length     = "5m"
    }

    metric {
      name       = "FreeableMemory"
      statistics = ["Minimum"]
      period     = "1m"
      length     = "5m"
    }

    metric {
      name       = "DatabaseConnections"
      statistics = ["Maximum"]
      period     = "1m"
      length     = "5m"
    }

    metric {
      name       = "CPUUtilization"
      statistics = ["Average"]
      period     = "1m"
      length     = "5m"
    }

    // RDS 의 t4g 는 Unlimited 모드라 크레딧이 바닥나도 느려지지 않고, 기준을 넘는 사용분에 요금이 붙는다.
    metric {
      name       = "CPUCreditBalance"
      statistics = ["Minimum"]
      period     = "5m"
      length     = "10m"
    }
  }
}

prometheus.scrape "rds" {
  targets         = prometheus.exporter.cloudwatch.rds.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }

  external_labels = {
    env = sys.env("DEVICA_ENV"),
  }
}

local.file_match "application_logs" {
  path_targets = [
    {"__path__" = "/var/log/devica/app/app.log", "app" = "devica-app"},
  ]
}

loki.source.file "application_logs" {
  targets    = local.file_match.application_logs.targets
  forward_to = [loki.process.application_logs.receiver]
}

loki.process "application_logs" {
  stage.match {
    selector = "{app=\"devica-app\"}"
    stage.json {
      expressions = { timestamp = "\"@timestamp\"" }
    }
    stage.timestamp {
      source = "timestamp"
      format = "RFC3339Nano"
      action_on_failure = "skip"
    }
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }

  external_labels = {
    env = sys.env("DEVICA_ENV"),
  }
}
